---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)]/70 mt-20">
  <div class="max-w-2xl mx-auto px-5 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
    <div class="flex items-center gap-3">
      <span class="font-serif-editorial italic text-lg text-[var(--text)] leading-none">KAK</span>
      <span aria-hidden="true">&middot;</span>
      <span class="tabular-nums">&copy; {year} Konaté Abdoul Karim</span>
    </div>

    <div class="flex items-center gap-5">
      <a
        href="/posts/"
        class="hover:text-[var(--text)] transition-colors"
      >
        Posts
      </a>
      <a
        href="/about/"
        data-i18n-fr="À propos"
        data-i18n-en="About"
        class="hover:text-[var(--text)] transition-colors"
      >
        About
      </a>
      <a
        href="https://github.com/karimgamin2000-beep"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--text)] transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://x.com/Karimpromax1"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--text)] transition-colors"
      >
        X
      </a>
    </div>
  </div>
</footer>
