---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Posts' },
  { href: '/about', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md">
  <div class="max-w-3xl mx-auto px-5 sm:px-6 h-14 flex items-center justify-between gap-4">
    <a
      href="/"
      class="flex items-center gap-2.5 font-semibold tracking-tight text-sm sm:text-base hover:opacity-80 transition-opacity"
    >
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-blue-600 text-white font-mono text-xs font-bold">
        K
      </span>
      <span>karim.dev</span>
      <span class="hidden sm:inline-block font-mono text-xs text-[var(--text-muted)] font-normal">
        // notes
      </span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      {
        navLinks.map((link) => {
          const isActive =
            link.href === '/'
              ? pathname === '/'
              : pathname.startsWith(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'px-2.5 py-1.5 rounded-md text-sm transition-colors',
                isActive
                  ? 'text-[var(--text)] font-medium bg-[var(--bg-subtle)]'
                  : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]/60',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="ml-1 p-2 rounded-md border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
