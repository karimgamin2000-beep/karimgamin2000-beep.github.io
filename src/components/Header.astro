---
import { getCollection } from 'astro:content';

const pathname = Astro.url.pathname;
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const lastArticles = allPosts.slice(0, 3);
const popularArticles = allPosts.filter((p) => p.data.popular || p.data.featured).slice(0, 3);
---

<header class="sticky top-0 z-40 w-full bg-[var(--bg)]/85 backdrop-blur-md border-b border-[var(--border)]/50">
  <div class="relative max-w-2xl mx-auto px-5 sm:px-6 h-14 flex items-center justify-between gap-4">
    <!-- KAK Serif Italic Logo -->
    <a
      href="/"
      aria-label="KAK Home"
      class="font-serif-editorial italic text-[26px] leading-none tracking-wide text-[var(--text)] hover:opacity-80 transition-opacity select-none"
    >
      KAK
    </a>

    <!-- Navigation + Popovers -->
    <nav aria-label="Main navigation" class="flex items-center gap-1 sm:gap-2">
      <!-- Explorer Popover Trigger -->
      <button
        id="explorer-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="explorer-popover"
        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md text-sm text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
      >
        <span data-i18n-fr="Explorer" data-i18n-en="Explore">Explorer</span>
        <svg
          id="explorer-chevron"
          class="w-3.5 h-3.5 transition-transform duration-150"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <a
        href="/posts/"
        class:list={[
          'px-2.5 py-1.5 rounded-md text-sm transition-colors',
          pathname.startsWith('/posts')
            ? 'text-[var(--text)] font-medium bg-[var(--bg-subtle)]'
            : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]/70',
        ]}
      >
        Posts
      </a>

      <a
        href="/about/"
        class:list={[
          'px-2.5 py-1.5 rounded-md text-sm transition-colors',
          pathname.startsWith('/about')
            ? 'text-[var(--text)] font-medium bg-[var(--bg-subtle)]'
            : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]/70',
        ]}
      >
        About
      </a>

      <!-- Bilingual Language Popover (right next to theme toggle) -->
      <div class="relative ml-1">
        <button
          id="lang-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="lang-popover"
          aria-label="Change language"
          class="inline-flex items-center gap-1 px-2 py-1.5 rounded-md text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a14.5 14.5 0 010 18M12 3a14.5 14.5 0 000 18" />
          </svg>
          <span data-lang-badge>FR</span>
        </button>

        <div
          id="lang-popover"
          role="menu"
          class="hidden absolute right-0 mt-2 w-40 rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-1.5 shadow-xl shadow-black/40 z-50"
        >
          <button
            type="button"
            role="menuitemradio"
            aria-checked="true"
            data-lang-option="fr"
            class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-xs text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
          >
            <span>Français <span class="font-mono text-[var(--text-muted)] ml-1">FR</span></span>
            <svg data-lang-check class="w-3.5 h-3.5 text-[var(--text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </button>
          <button
            type="button"
            role="menuitemradio"
            aria-checked="false"
            data-lang-option="en"
            class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-xs text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
          >
            <span>English <span class="font-mono text-[var(--text-muted)] ml-1">EN</span></span>
            <svg data-lang-check class="w-3.5 h-3.5 text-[var(--text)] opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        class="p-2 rounded-md text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
      >
        <svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
    </nav>

    <!-- Explorer Popover Panel (Codelynx-style) -->
    <div
      id="explorer-popover"
      class="hidden absolute left-4 right-4 sm:left-6 sm:right-6 top-[calc(100%+0.5rem)] rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5 sm:p-6 shadow-2xl shadow-black/50 z-50"
    >
      <p
        class="text-xs font-medium text-[var(--text-muted)] mb-3.5"
        data-i18n-fr="Catégories"
        data-i18n-en="Categories"
      >
        Catégories
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-5 border-b border-[var(--border)]">
        <a
          href="/posts/?category=ai"
          class="group flex items-start gap-3 rounded-xl p-2.5 -mx-1 hover:bg-[var(--bg-subtle)] transition-colors"
        >
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg)] text-violet-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </span>
          <div class="min-w-0">
            <p
              class="text-sm font-medium text-[var(--text)] group-hover:underline underline-offset-4"
              data-i18n-fr="Intelligence artificielle"
              data-i18n-en="Artificial Intelligence"
            >
              Intelligence artificielle
            </p>
            <p
              class="text-xs text-[var(--text-muted)] line-clamp-1 mt-0.5"
              data-i18n-fr="LLMs, agents autonomes, pipelines IA & recherche."
              data-i18n-en="LLMs, autonomous agents, AI pipelines & research."
            >
              LLMs, agents autonomes, pipelines IA &amp; recherche.
            </p>
          </div>
        </a>

        <a
          href="/posts/?category=tools"
          class="group flex items-start gap-3 rounded-xl p-2.5 -mx-1 hover:bg-[var(--bg-subtle)] transition-colors"
        >
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg)] text-sky-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
            </svg>
          </span>
          <div class="min-w-0">
            <p
              class="text-sm font-medium text-[var(--text)] group-hover:underline underline-offset-4"
              data-i18n-fr="Outils de développement"
              data-i18n-en="Developer Tools"
            >
              Outils de développement
            </p>
            <p
              class="text-xs text-[var(--text-muted)] line-clamp-1 mt-0.5"
              data-i18n-fr="Stack, CLI, éditeurs, Python, TypeScript & workflows."
              data-i18n-en="Stack, CLI, editors, Python, TypeScript & workflows."
            >
              Stack, CLI, éditeurs, Python, TypeScript &amp; workflows.
            </p>
          </div>
        </a>
      </div>

      <!-- Last articles & Popular articles -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div>
          <p class="text-xs font-medium text-[var(--text-muted)] mb-2.5">
            Last articles
          </p>
          {
            lastArticles.length > 0 ? (
              <ul class="space-y-2">
                {lastArticles.map((post) => (
                  <li>
                    <a
                      href={`/posts/${post.id}/`}
                      class="group flex items-center gap-2 text-sm text-[var(--text)] hover:text-[var(--text-muted)] transition-colors"
                    >
                      <span class="text-[var(--text-muted)] group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                      <span class="truncate">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p
                class="text-xs text-[var(--text-muted)] italic"
                data-i18n-fr="Aucun article publié pour le moment."
                data-i18n-en="No articles published yet."
              >
                Aucun article publié pour le moment.
              </p>
            )
          }
        </div>

        <div>
          <p class="text-xs font-medium text-[var(--text-muted)] mb-2.5">
            Popular articles
          </p>
          {
            popularArticles.length > 0 ? (
              <ul class="space-y-2">
                {popularArticles.map((post) => (
                  <li>
                    <a
                      href={`/posts/${post.id}/`}
                      class="group flex items-center gap-2 text-sm text-[var(--text)] hover:text-[var(--text-muted)] transition-colors"
                    >
                      <span class="text-[var(--text-muted)] group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                      <span class="truncate">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p
                class="text-xs text-[var(--text-muted)] italic"
                data-i18n-fr="Aucun article populaire pour le moment."
                data-i18n-en="No popular articles yet."
              >
                Aucun article populaire pour le moment.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const explorerTrigger = document.getElementById('explorer-trigger');
    const explorerPopover = document.getElementById('explorer-popover');
    const explorerChevron = document.getElementById('explorer-chevron');

    const langTrigger = document.getElementById('lang-trigger');
    const langPopover = document.getElementById('lang-popover');

    function closeExplorer() {
      explorerPopover?.classList.add('hidden');
      explorerTrigger?.setAttribute('aria-expanded', 'false');
      explorerChevron?.classList.remove('rotate-180');
    }

    function closeLang() {
      langPopover?.classList.add('hidden');
      langTrigger?.setAttribute('aria-expanded', 'false');
    }

    explorerTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !explorerPopover?.classList.contains('hidden');
      closeLang();
      if (isOpen) {
        closeExplorer();
      } else {
        explorerPopover?.classList.remove('hidden');
        explorerTrigger?.setAttribute('aria-expanded', 'true');
        explorerChevron?.classList.add('rotate-180');
      }
    });

    langTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !langPopover?.classList.contains('hidden');
      closeExplorer();
      if (isOpen) {
        closeLang();
      } else {
        langPopover?.classList.remove('hidden');
        langTrigger?.setAttribute('aria-expanded', 'true');
      }
    });

    document.querySelectorAll('[data-lang-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang-option') || 'fr';
        if (window.applySiteLang) window.applySiteLang(lang);
        closeLang();
      });
    });

    document.addEventListener('click', (e) => {
      if (!explorerPopover?.contains(e.target) && e.target !== explorerTrigger) {
        closeExplorer();
      }
      if (!langPopover?.contains(e.target) && e.target !== langTrigger) {
        closeLang();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeExplorer();
        closeLang();
      }
    });

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  })();
</script>
