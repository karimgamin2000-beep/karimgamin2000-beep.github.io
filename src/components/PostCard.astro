---
import { estimateReadingTime, formatShortDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const readingTime = estimateReadingTime(post.body);
const { title, description, pubDate, lang, tags } = post.data;
---

<article
  data-post-card
  data-lang={lang}
  data-tags={tags.join(',')}
  class="group relative rounded-xl border border-[var(--border)] bg-[var(--bg)] p-5 transition-all duration-200 hover:border-blue-500/50 hover:bg-[var(--bg-subtle)]/50"
>
  <a href={`/posts/${post.id}`} class="block focus:outline-none">
    <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono text-[var(--text-muted)] mb-2">
      <time datetime={pubDate.toISOString()}>{formatShortDate(pubDate)}</time>
      <span>&middot;</span>
      <span>{readingTime} min read</span>
      <span
        class:list={[
          'px-1.5 py-0.5 rounded text-[10px] uppercase font-semibold tracking-wider border',
          lang === 'fr'
            ? 'border-amber-500/30 bg-amber-500/10 text-amber-500'
            : 'border-blue-500/30 bg-blue-500/10 text-blue-500',
        ]}
      >
        {lang}
      </span>
    </div>

    <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-[var(--text)] group-hover:text-blue-500 transition-colors">
      {title}
    </h2>

    <p class="mt-1.5 text-sm text-[var(--text-muted)] leading-relaxed line-clamp-2">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="mt-3.5 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="px-2 py-0.5 rounded-md bg-[var(--bg-subtle)] border border-[var(--border)] text-[11px] font-mono text-[var(--text-muted)]">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </a>
</article>
