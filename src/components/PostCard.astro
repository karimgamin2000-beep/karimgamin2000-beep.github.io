---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, lang, category, tags } = post.data;
const searchBlob = `${title} ${description} ${category} ${tags.join(' ')}`.toLowerCase();
const categoryLabel = category === 'ai' ? 'AI' : 'Tools';
---

<article
  data-post-card
  data-lang={lang}
  data-category={category}
  data-tags={tags.join(',')}
  data-date={pubDate.valueOf()}
  data-search={searchBlob}
  class="group py-5 first:pt-1 transition-colors"
>
  <a href={`/posts/${post.id}/`} class="block focus:outline-none">
    <h3 class="font-display text-base sm:text-[17px] font-semibold tracking-tight text-[var(--text)] group-hover:text-[var(--text-muted)] transition-colors">
      {title}
    </h3>

    <p class="mt-1.5 text-sm text-[var(--text-muted)] leading-relaxed line-clamp-2">
      {description}
    </p>

    <div class="mt-2.5 flex items-center gap-2 text-xs text-[var(--text-muted)]/80">
      <time datetime={pubDate.toISOString()} class="tabular-nums">
        {formatDate(pubDate, lang)}
      </time>
      <span aria-hidden="true">&bull;</span>
      <span>{categoryLabel}</span>
    </div>
  </a>
</article>
