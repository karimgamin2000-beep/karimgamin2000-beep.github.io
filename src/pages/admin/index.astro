---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';

const buildPosts = await getCollection('posts');
const buildStats = {
  total: buildPosts.length,
  published: buildPosts.filter((p) => !p.data.draft).length,
  drafts: buildPosts.filter((p) => p.data.draft).length,
  en: buildPosts.filter((p) => p.data.lang === 'en' && !p.data.draft).length,
  fr: buildPosts.filter((p) => p.data.lang === 'fr' && !p.data.draft).length,
  totalWords: buildPosts.reduce((acc, p) => acc + (p.body ? p.body.trim().split(/\s+/).length : 0), 0),
  goatcounterCode: SITE_CONFIG.goatcounterCode,
};
---

<BaseLayout
  title="Admin Dashboard — KAK"
  description="Private owner dashboard for managing KAK blog articles and analytics."
  noindex={true}
>
  <style is:global>
    main:has(#admin-root) {
      max-width: 64rem;
    }
  </style>

  <div id="admin-root" class="space-y-8" data-build-stats={JSON.stringify(buildStats)}>
    <!-- Top bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border)]">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="font-pixel text-3xl tracking-tight text-[var(--text)]">KAK Admin</h1>
          <span
            id="auth-badge"
            class="px-2 py-0.5 rounded-full text-[11px] font-mono border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text-muted)]"
          >
            Locked
          </span>
        </div>
        <p
          class="mt-1 text-sm text-[var(--text-muted)]"
          data-i18n-fr="Espace propriétaire : rédaction, publication GitHub et suivi des analytics."
          data-i18n-en="Owner workspace: write, publish to GitHub, and track blog analytics."
        >
          Owner workspace: write, publish to GitHub, and track blog analytics.
        </p>
      </div>

      <div id="owner-bar" class="hidden items-center gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)]">
          <img id="owner-avatar" src="" alt="" class="w-5 h-5 rounded-full hidden" />
          <span id="owner-login" class="text-xs font-mono text-[var(--text)]"></span>
        </div>
        <button
          id="logout-btn"
          type="button"
          class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
          data-i18n-fr="Déconnexion"
          data-i18n-en="Sign out"
        >
          Sign out
        </button>
      </div>
    </div>

    <!-- Status / Toast Banner -->
    <div id="admin-toast" class="hidden rounded-xl border px-4 py-3 text-sm"></div>

    <!-- AUTH / ACCESS GATE -->
    <section id="auth-gate" class="grid grid-cols-1 lg:grid-cols-5 gap-6">
      <!-- Owner Login Card -->
      <div class="lg:col-span-3 rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 space-y-5">
        <div>
          <h2
            class="font-display text-xl font-semibold text-[var(--text)]"
            data-i18n-fr="Connexion Propriétaire"
            data-i18n-en="Owner Sign-In"
          >
            Owner Sign-In
          </h2>
          <p
            class="mt-1 text-sm text-[var(--text-muted)]"
            data-i18n-fr="Authentification vérifiée en direct via l'API GitHub (droits push requis sur karimgamin2000-beep.github.io)."
            data-i18n-en="Live verification via GitHub API (push access required on karimgamin2000-beep.github.io)."
          >
            Live verification via GitHub API (push access required on karimgamin2000-beep.github.io).
          </p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="pat-input" class="block text-xs font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1.5">
              GitHub Fine-Grained Personal Access Token
            </label>
            <input
              id="pat-input"
              type="password"
              required
              autocomplete="off"
              placeholder="github_pat_..."
              class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3.5 py-2.5 text-sm font-mono text-[var(--text)] placeholder:text-[var(--text-muted)] focus:border-[var(--border-strong)] focus:outline-none"
            />
          </div>

          <label class="flex items-center gap-2 text-xs text-[var(--text-muted)] cursor-pointer select-none">
            <input id="remember-token" type="checkbox" class="rounded border-[var(--border)] accent-[var(--text)]" />
            <span
              data-i18n-fr="Mémoriser le token dans ce navigateur (localStorage)"
              data-i18n-en="Remember token in this browser (localStorage)"
            >
              Remember token in this browser (localStorage)
            </span>
          </label>

          <button
            id="login-submit"
            type="submit"
            class="w-full sm:w-auto px-5 py-2.5 rounded-lg bg-[var(--text)] text-[var(--bg)] text-sm font-medium hover:opacity-90 transition-opacity cursor-pointer"
            data-i18n-fr="Vérifier et accéder au Dashboard"
            data-i18n-en="Verify & Unlock Dashboard"
          >
            Verify &amp; Unlock Dashboard
          </button>
        </form>

        <details class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 text-xs text-[var(--text-muted)] space-y-2">
          <summary
            class="font-mono font-medium text-[var(--text)] cursor-pointer select-none"
            data-i18n-fr="Comment créer ton token propriétaire (1 min)"
            data-i18n-en="How to create your owner token (1 min)"
          >
            How to create your owner token (1 min)
          </summary>
          <ol class="list-decimal pl-4 space-y-1.5 pt-2 leading-relaxed">
            <li>
              <a
                href="https://github.com/settings/personal-access-tokens/new"
                target="_blank"
                rel="noopener noreferrer"
                class="underline text-[var(--text)]"
              >
                Open GitHub Fine-Grained Tokens
              </a>
            </li>
            <li>Repository access: <strong>Only select repositories</strong> &rarr; <code>karimgamin2000-beep.github.io</code></li>
            <li>Permissions: <strong>Contents: Read and write</strong> (required to publish/edit posts) + <strong>Administration: Read</strong> (optional, for repo traffic analytics).</li>
            <li>Your token never leaves your browser except to talk directly to <code>api.github.com</code>.</li>
          </ol>
        </details>
      </div>

      <!-- Request Access Card (for visitors / non-owners) -->
      <div class="lg:col-span-2 rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 space-y-4">
        <div>
          <h2
            class="font-display text-lg font-semibold text-[var(--text)]"
            data-i18n-fr="Demander l'accès"
            data-i18n-en="Request Access"
          >
            Request Access
          </h2>
          <p
            class="mt-1 text-xs text-[var(--text-muted)] leading-relaxed"
            data-i18n-fr="Tu es contributeur ou invité ? Envoie une demande d'accès au propriétaire du blog."
            data-i18n-en="Are you a guest author or collaborator? Send an access request to the blog owner."
          >
            Are you a guest author or collaborator? Send an access request to the blog owner.
          </p>
        </div>

        <form id="request-access-form" class="space-y-3">
          <input
            id="req-name"
            type="text"
            required
            placeholder="Name / GitHub @handle"
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs text-[var(--text)] placeholder:text-[var(--text-muted)] focus:border-[var(--border-strong)] focus:outline-none"
          />
          <input
            id="req-email"
            type="email"
            required
            placeholder="Email"
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs text-[var(--text)] placeholder:text-[var(--text-muted)] focus:border-[var(--border-strong)] focus:outline-none"
          />
          <textarea
            id="req-reason"
            rows="3"
            required
            placeholder="Reason / article topic..."
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs text-[var(--text)] placeholder:text-[var(--text-muted)] focus:border-[var(--border-strong)] focus:outline-none"
          ></textarea>
          <button
            type="submit"
            class="w-full px-4 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg-subtle)] text-xs font-mono text-[var(--text)] hover:border-[var(--border-strong)] transition-colors cursor-pointer"
            data-i18n-fr="Envoyer la demande via GitHub Issue"
            data-i18n-en="Send Request via GitHub Issue"
          >
            Send Request via GitHub Issue
          </button>
        </form>
      </div>
    </section>

    <!-- AUTHENTICATED WORKSPACE -->
    <section id="admin-workspace" class="hidden space-y-6">
      <!-- Navigation Tabs -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="inline-flex rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-1" role="tablist">
          <button
            type="button"
            role="tab"
            data-tab-btn="analytics"
            class="admin-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium bg-[var(--text)] text-[var(--bg)] transition-colors cursor-pointer"
          >
            Analytics &amp; Trends
          </button>
          <button
            type="button"
            role="tab"
            data-tab-btn="posts"
            class="admin-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer"
          >
            Posts
          </button>
          <button
            type="button"
            role="tab"
            data-tab-btn="editor"
            class="admin-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer"
          >
            + New / Editor
          </button>
        </div>

        <button
          id="refresh-data-btn"
          type="button"
          class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
        >
          ↻ Sync GitHub
        </button>
      </div>

      <!-- TAB 1: ANALYTICS & TRENDS -->
      <div id="tab-analytics" class="space-y-6">
        <!-- KPI Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4">
            <p class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Published</p>
            <p id="kpi-published" class="mt-1.5 font-display text-2xl font-semibold text-[var(--text)] tabular-nums">-</p>
            <p id="kpi-drafts" class="mt-0.5 text-xs text-[var(--text-muted)] font-mono">- drafts</p>
          </div>
          <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4">
            <p class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">EN / FR</p>
            <p id="kpi-langs" class="mt-1.5 font-display text-2xl font-semibold text-[var(--text)] tabular-nums">-</p>
            <p class="mt-0.5 text-xs text-[var(--text-muted)] font-mono">bilingual split</p>
          </div>
          <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4">
            <p class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Repo Views (14d)</p>
            <p id="kpi-views" class="mt-1.5 font-display text-2xl font-semibold text-[var(--text)] tabular-nums">-</p>
            <p id="kpi-uniques" class="mt-0.5 text-xs text-[var(--text-muted)] font-mono">- unique</p>
          </div>
          <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4">
            <p class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Total Words</p>
            <p id="kpi-words" class="mt-1.5 font-display text-2xl font-semibold text-[var(--text)] tabular-nums">-</p>
            <p id="kpi-clones" class="mt-0.5 text-xs text-[var(--text-muted)] font-mono">- clones (14d)</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- GitHub Traffic & Referrers -->
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5 space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-base font-semibold text-[var(--text)]">GitHub Traffic &amp; Referrers (14d)</h3>
              <span class="text-[11px] font-mono text-[var(--text-muted)]">Live API</span>
            </div>
            <div id="traffic-container" class="text-xs text-[var(--text-muted)] space-y-2">
              Loading traffic data...
            </div>
          </div>

          <!-- Tag & Category Trends -->
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5 space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-base font-semibold text-[var(--text)]">Topics &amp; Tags Distribution</h3>
              <span class="text-[11px] font-mono text-[var(--text-muted)]">Content</span>
            </div>
            <div id="tags-chart" class="space-y-2.5 text-xs">
              Loading topics...
            </div>
          </div>
        </div>

        <!-- Recent Commits + GoatCounter Hook -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5 space-y-3">
            <h3 class="font-display text-base font-semibold text-[var(--text)]">Recent Deployments &amp; Commits</h3>
            <ul id="commits-list" class="space-y-2 text-xs"></ul>
          </div>

          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5 space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-base font-semibold text-[var(--text)]">Web Pageviews (GoatCounter)</h3>
              <span class="text-[11px] font-mono text-[var(--text-muted)]">Optional</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">
              GitHub Traffic tracks repository visits. For live blog reader pageviews, connect a free GoatCounter code (e.g. <code>kak-blog</code>).
            </p>
            <div class="flex gap-2">
              <input
                id="gc-code-input"
                type="text"
                placeholder="GoatCounter site code (e.g. kak-blog)"
                class="flex-1 rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-1.5 text-xs font-mono text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
              <button
                id="gc-save-btn"
                type="button"
                class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--bg-subtle)] text-xs font-mono text-[var(--text)] hover:border-[var(--border-strong)] cursor-pointer"
              >
                Save
              </button>
            </div>
            <div id="gc-status" class="text-xs text-[var(--text-muted)]"></div>
          </div>
        </div>
      </div>

      <!-- TAB 2: POSTS MANAGER -->
      <div id="tab-posts" class="hidden space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" data-admin-filter="all" class="admin-filter-btn px-2.5 py-1 rounded-md text-xs font-mono bg-[var(--text)] text-[var(--bg)] cursor-pointer">ALL</button>
            <button type="button" data-admin-filter="published" class="admin-filter-btn px-2.5 py-1 rounded-md text-xs font-mono border border-[var(--border)] text-[var(--text-muted)] cursor-pointer">Published</button>
            <button type="button" data-admin-filter="draft" class="admin-filter-btn px-2.5 py-1 rounded-md text-xs font-mono border border-[var(--border)] text-[var(--text-muted)] cursor-pointer">Drafts</button>
            <button type="button" data-admin-filter="en" class="admin-filter-btn px-2.5 py-1 rounded-md text-xs font-mono border border-[var(--border)] text-[var(--text-muted)] cursor-pointer">EN</button>
            <button type="button" data-admin-filter="fr" class="admin-filter-btn px-2.5 py-1 rounded-md text-xs font-mono border border-[var(--border)] text-[var(--text-muted)] cursor-pointer">FR</button>
          </div>
          <button
            id="new-post-shortcut"
            type="button"
            class="px-3.5 py-1.5 rounded-lg bg-[var(--text)] text-[var(--bg)] text-xs font-mono font-medium hover:opacity-90 cursor-pointer"
          >
            + New Article
          </button>
        </div>

        <div id="admin-posts-list" class="divide-y divide-[var(--border)] rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] overflow-hidden">
          <div class="p-6 text-center text-sm text-[var(--text-muted)]">Loading articles from GitHub...</div>
        </div>
      </div>

      <!-- TAB 3: MARKDOWN EDITOR -->
      <div id="tab-editor" class="hidden space-y-5">
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5 space-y-4">
          <div class="flex items-center justify-between">
            <h2 id="editor-heading" class="font-display text-lg font-semibold text-[var(--text)]">New Article</h2>
            <button
              id="editor-reset-btn"
              type="button"
              class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)] underline cursor-pointer"
            >
              Reset / Clear
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div class="sm:col-span-2">
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Title</label>
              <input
                id="ed-title"
                type="text"
                placeholder="e.g. Building My First AI Software Factory"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Filename Slug (.md)</label>
              <input
                id="ed-slug"
                type="text"
                placeholder="my-article-slug"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Publish Date</label>
              <input
                id="ed-date"
                type="date"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
            </div>

            <div class="sm:col-span-2">
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Description (SEO &amp; Card Summary)</label>
              <input
                id="ed-description"
                type="text"
                placeholder="One-sentence summary of the article..."
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Language</label>
              <select id="ed-lang" class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)]">
                <option value="en">en (English)</option>
                <option value="fr">fr (Français)</option>
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Category</label>
              <select id="ed-category" class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)]">
                <option value="ai">ai (Artificial Intelligence)</option>
                <option value="tools">tools (Dev Tools)</option>
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Tags (comma-separated)</label>
              <input
                id="ed-tags"
                type="text"
                placeholder="software-factory, ai-agents, architecture"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-1">Translation Slug (EN &harr; FR)</label>
              <input
                id="ed-translation-slug"
                type="text"
                placeholder="optional-paired-article-slug"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
              />
            </div>

            <div class="sm:col-span-2 flex flex-wrap items-center gap-5 pt-1 text-xs font-mono text-[var(--text-muted)]">
              <label class="flex items-center gap-2 cursor-pointer">
                <input id="ed-draft" type="checkbox" class="accent-[var(--text)]" />
                <span>draft (hidden from public)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input id="ed-featured" type="checkbox" class="accent-[var(--text)]" />
                <span>featured</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input id="ed-popular" type="checkbox" class="accent-[var(--text)]" />
                <span>popular</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Markdown Toolbar + Split Editor -->
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 border-b border-[var(--border)] bg-[var(--bg-subtle)]">
            <div class="flex flex-wrap items-center gap-1">
              <button type="button" data-md-insert="## " class="md-tool px-2 py-1 rounded text-xs font-mono hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">H2</button>
              <button type="button" data-md-insert="### " class="md-tool px-2 py-1 rounded text-xs font-mono hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">H3</button>
              <button type="button" data-md-wrap="**" class="md-tool px-2 py-1 rounded text-xs font-mono font-bold hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">B</button>
              <button type="button" data-md-wrap="*" class="md-tool px-2 py-1 rounded text-xs font-mono italic hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">I</button>
              <button type="button" data-md-wrap="`" class="md-tool px-2 py-1 rounded text-xs font-mono hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">&lt;/&gt;</button>
              <button type="button" data-md-insert="> " class="md-tool px-2 py-1 rounded text-xs font-mono hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">Quote</button>
              <button type="button" data-md-insert="- " class="md-tool px-2 py-1 rounded text-xs font-mono hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">List</button>
              <button type="button" data-md-insert="[text](https://)" class="md-tool px-2 py-1 rounded text-xs font-mono hover:bg-[var(--bg-elevated)] text-[var(--text)] cursor-pointer">Link</button>
            </div>

            <div class="flex items-center gap-3 text-[11px] font-mono text-[var(--text-muted)]">
              <span id="ed-stats">0 words &middot; 1 min read</span>
              <div class="inline-flex rounded-md border border-[var(--border)] bg-[var(--bg)] p-0.5">
                <button type="button" data-view-mode="split" class="view-mode-btn px-2 py-0.5 rounded bg-[var(--text)] text-[var(--bg)] cursor-pointer">Split</button>
                <button type="button" data-view-mode="write" class="view-mode-btn px-2 py-0.5 rounded text-[var(--text-muted)] cursor-pointer">Write</button>
                <button type="button" data-view-mode="preview" class="view-mode-btn px-2 py-0.5 rounded text-[var(--text-muted)] cursor-pointer">Preview</button>
              </div>
            </div>
          </div>

          <div id="editor-panes" class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[var(--border)]">
            <textarea
              id="ed-body"
              rows="18"
              placeholder="Write your article in Markdown..."
              class="w-full p-4 bg-[var(--bg)] text-sm font-mono text-[var(--text)] leading-relaxed focus:outline-none resize-y min-h-[380px]"
            ></textarea>
            <div id="ed-preview" class="p-5 prose max-w-none overflow-y-auto max-h-[540px] bg-[var(--bg-elevated)]">
              <p class="text-sm text-[var(--text-muted)] italic">Live preview will appear here...</p>
            </div>
          </div>
        </div>

        <!-- Publish Bar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4">
          <input
            id="ed-commit-msg"
            type="text"
            placeholder="Commit message (auto-generated if empty)"
            class="flex-1 rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-xs font-mono text-[var(--text)] focus:border-[var(--border-strong)] focus:outline-none"
          />
          <div class="flex items-center gap-2.5">
            <button
              id="save-draft-btn"
              type="button"
              class="px-4 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg-subtle)] text-xs font-mono text-[var(--text)] hover:border-[var(--border-strong)] cursor-pointer"
            >
              Save as Draft
            </button>
            <button
              id="publish-btn"
              type="button"
              class="px-5 py-2 rounded-lg bg-[var(--text)] text-[var(--bg)] text-xs font-mono font-semibold hover:opacity-90 cursor-pointer"
            >
              Publish to GitHub &rarr;
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      const OWNER = 'karimgamin2000-beep';
      const REPO = 'karimgamin2000-beep.github.io';
      const POSTS_PATH = 'src/content/posts';
      const TOKEN_KEY = 'kak_admin_gh_pat';
      const GC_KEY = 'kak_admin_goatcounter';
      const DRAFT_KEY = 'kak_admin_local_draft';

      let token = '';
      let editingSha = null;
      let editingOriginalPath = null;
      let loadedPosts = [];
      let currentFilter = 'all';

      const root = document.getElementById('admin-root');
      const buildStats = JSON.parse(root?.dataset.buildStats || '{}');

      const authGate = document.getElementById('auth-gate');
      const workspace = document.getElementById('admin-workspace');
      const authBadge = document.getElementById('auth-badge');
      const ownerBar = document.getElementById('owner-bar');
      const ownerAvatar = document.getElementById('owner-avatar');
      const ownerLogin = document.getElementById('owner-login');
      const toast = document.getElementById('admin-toast');

      function showToast(msg, type = 'info') {
        if (!toast) return;
        toast.classList.remove('hidden', 'border-red-500/40', 'bg-red-500/10', 'text-red-400', 'border-emerald-500/40', 'bg-emerald-500/10', 'text-emerald-400', 'border-[var(--border)]', 'bg-[var(--bg-elevated)]', 'text-[var(--text)]');
        if (type === 'error') {
          toast.classList.add('border-red-500/40', 'bg-red-500/10', 'text-red-400');
        } else if (type === 'success') {
          toast.classList.add('border-emerald-500/40', 'bg-emerald-500/10', 'text-emerald-400');
        } else {
          toast.classList.add('border-[var(--border)]', 'bg-[var(--bg-elevated)]', 'text-[var(--text)]');
        }
        toast.innerHTML = msg;
      }

      function hideToast() {
        toast?.classList.add('hidden');
      }

      async function ghFetch(path, options = {}) {
        const url = path.startsWith('http') ? path : `https://api.github.com${path}`;
        const res = await fetch(url, {
          ...options,
          headers: {
            Accept: 'application/vnd.github+json',
            Authorization: `Bearer ${token}`,
            'X-GitHub-Api-Version': '2022-11-28',
            ...(options.headers || {}),
          },
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.message || `GitHub API error (${res.status})`);
        }
        return res.json();
      }

      function encodeBase64Utf8(str) {
        const bytes = new TextEncoder().encode(str);
        let binary = '';
        bytes.forEach((b) => (binary += String.fromCharCode(b)));
        return btoa(binary);
      }

      function decodeBase64Utf8(b64) {
        const binary = atob(b64.replace(/\n/g, ''));
        const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      }

      function parseFrontmatter(raw) {
        const match = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
        if (!match) return { data: {}, body: raw };
        const yaml = match[1];
        const body = match[2];
        const data = {};
        yaml.split(/\r?\n/).forEach((line) => {
          const idx = line.indexOf(':');
          if (idx === -1) return;
          const key = line.slice(0, idx).trim();
          let val = line.slice(idx + 1).trim();
          if (val.startsWith('[') && val.endsWith(']')) {
            data[key] = val
              .slice(1, -1)
              .split(',')
              .map((s) => s.trim().replace(/^["']|["']$/g, ''))
              .filter(Boolean);
          } else if (val === 'true' || val === 'false') {
            data[key] = val === 'true';
          } else {
            data[key] = val.replace(/^["']|["']$/g, '');
          }
        });
        return { data, body };
      }

      function slugify(str) {
        return str
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function renderMarkdownPreview(md) {
        if (!md.trim()) return '<p class="text-sm text-[var(--text-muted)] italic">Live preview will appear here...</p>';
        let html = escapeHtml(md);
        // Fenced code blocks
        html = html.replace(/```(\w*)\n([\s\S]*?)```/g, (_, lang, code) => `<pre><code>${code}</code></pre>`);
        // Headings
        html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
        html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
        html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');
        // Blockquotes
        html = html.replace(/^&gt; (.+)$/gm, '<blockquote><p>$1</p></blockquote>');
        // Lists
        html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
        html = html.replace(/(<li>.*<\/li>\n?)+/g, (m) => `<ul>${m}</ul>`);
        // Inline formatting
        html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
        html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
        html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
        // Paragraphs
        html = html
          .split(/\n{2,}/)
          .map((block) => {
            if (/^<(h[1-3]|ul|ol|pre|blockquote)/.test(block.trim())) return block;
            return `<p>${block.replace(/\n/g, '<br />')}</p>`;
          })
          .join('\n');
        return html;
      }

      async function verifyAndUnlock(candidateToken) {
        token = candidateToken.trim();
        if (!token) return;
        const submitBtn = document.getElementById('login-submit');
        if (submitBtn) submitBtn.textContent = 'Verifying...';

        try {
          const [user, repo] = await Promise.all([
            ghFetch('/user'),
            ghFetch(`/repos/${OWNER}/${REPO}`),
          ]);

          if (!repo.permissions?.push) {
            throw new Error(`Authenticated as @${user.login}, but push access to ${OWNER}/${REPO} is required.`);
          }

          authGate?.classList.add('hidden');
          workspace?.classList.remove('hidden');
          ownerBar?.classList.remove('hidden');
          ownerBar?.classList.add('flex');

          if (authBadge) {
            authBadge.textContent = 'Owner Verified';
            authBadge.classList.add('border-emerald-500/40', 'text-emerald-400');
          }
          if (ownerLogin) ownerLogin.textContent = `@${user.login}`;
          if (ownerAvatar && user.avatar_url) {
            ownerAvatar.src = user.avatar_url;
            ownerAvatar.classList.remove('hidden');
          }

          hideToast();
          await syncAllData();
        } catch (err) {
          token = '';
          sessionStorage.removeItem(TOKEN_KEY);
          localStorage.removeItem(TOKEN_KEY);
          showToast(`Access denied: ${err.message}`, 'error');
        } finally {
          if (submitBtn) submitBtn.textContent = 'Verify & Unlock Dashboard';
        }
      }

      async function syncAllData() {
        await Promise.all([loadPostsFromGitHub(), loadTrafficAndCommits()]);
        renderAnalytics();
      }

      async function loadPostsFromGitHub() {
        const listEl = document.getElementById('admin-posts-list');
        try {
          const files = await ghFetch(`/repos/${OWNER}/${REPO}/contents/${POSTS_PATH}`);
          const mdFiles = files.filter((f) => f.type === 'file' && /\.(md|mdx)$/.test(f.name));

          const detailed = await Promise.all(
            mdFiles.map(async (f) => {
              const fileObj = await ghFetch(`/repos/${OWNER}/${REPO}/contents/${f.path}`);
              const raw = decodeBase64Utf8(fileObj.content);
              const parsed = parseFrontmatter(raw);
              return {
                name: f.name,
                path: f.path,
                sha: fileObj.sha,
                data: parsed.data,
                body: parsed.body,
                words: parsed.body.trim() ? parsed.body.trim().split(/\s+/).length : 0,
              };
            })
          );

          loadedPosts = detailed.sort((a, b) =>
            String(b.data.pubDate || '').localeCompare(String(a.data.pubDate || ''))
          );
          renderPostsList();
        } catch (err) {
          if (listEl) listEl.innerHTML = `<div class="p-6 text-sm text-red-400">Error loading posts: ${err.message}</div>`;
        }
      }

      function renderPostsList() {
        const listEl = document.getElementById('admin-posts-list');
        if (!listEl) return;

        const filtered = loadedPosts.filter((p) => {
          if (currentFilter === 'published') return !p.data.draft;
          if (currentFilter === 'draft') return !!p.data.draft;
          if (currentFilter === 'en') return p.data.lang === 'en';
          if (currentFilter === 'fr') return p.data.lang === 'fr';
          return true;
        });

        if (filtered.length === 0) {
          listEl.innerHTML = '<div class="p-6 text-center text-sm text-[var(--text-muted)]">No articles match this filter.</div>';
          return;
        }

        listEl.innerHTML = filtered
          .map((p) => {
            const slug = p.name.replace(/\.(md|mdx)$/, '');
            const lang = (p.data.lang || 'en').toUpperCase();
            const isDraft = !!p.data.draft;
            return `
              <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[var(--bg-subtle)]/40 transition-colors">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono uppercase border border-[var(--border)] bg-[var(--bg)] text-[var(--text)]">${lang}</span>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono uppercase border border-[var(--border)] text-[var(--text-muted)]">${p.data.category || 'ai'}</span>
                    ${isDraft ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-mono uppercase bg-amber-500/15 text-amber-400 border border-amber-500/30">Draft</span>' : '<span class="px-1.5 py-0.5 rounded text-[10px] font-mono uppercase bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Live</span>'}
                    <span class="text-xs font-mono text-[var(--text-muted)] tabular-nums">${p.data.pubDate || ''} &middot; ${p.words} words</span>
                  </div>
                  <p class="font-display font-medium text-sm text-[var(--text)] truncate">${escapeHtml(p.data.title || slug)}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  ${!isDraft ? `<a href="/posts/${slug}/" target="_blank" class="px-2.5 py-1 rounded-md border border-[var(--border)] text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)]">View</a>` : ''}
                  <button type="button" data-edit-path="${p.path}" class="edit-post-btn px-2.5 py-1 rounded-md border border-[var(--border)] bg-[var(--bg)] text-xs font-mono text-[var(--text)] hover:border-[var(--border-strong)] cursor-pointer">Edit</button>
                  <button type="button" data-delete-path="${p.path}" class="delete-post-btn px-2.5 py-1 rounded-md border border-red-500/30 text-xs font-mono text-red-400 hover:bg-red-500/10 cursor-pointer">Delete</button>
                </div>
              </div>
            `;
          })
          .join('');

        listEl.querySelectorAll('.edit-post-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const post = loadedPosts.find((x) => x.path === btn.getAttribute('data-edit-path'));
            if (post) loadPostIntoEditor(post);
          });
        });

        listEl.querySelectorAll('.delete-post-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const post = loadedPosts.find((x) => x.path === btn.getAttribute('data-delete-path'));
            if (!post) return;
            if (!confirm(`Delete "${post.data.title || post.name}" from GitHub?`)) return;
            try {
              await ghFetch(`/repos/${OWNER}/${REPO}/contents/${post.path}`, {
                method: 'DELETE',
                body: JSON.stringify({
                  message: `chore(blog): delete ${post.name}`,
                  sha: post.sha,
                }),
              });
              showToast(`Deleted <code>${post.name}</code> from GitHub.`, 'success');
              await syncAllData();
            } catch (err) {
              showToast(`Delete failed: ${err.message}`, 'error');
            }
          });
        });
      }

      async function loadTrafficAndCommits() {
        const trafficEl = document.getElementById('traffic-container');
        const commitsEl = document.getElementById('commits-list');

        try {
          const commits = await ghFetch(`/repos/${OWNER}/${REPO}/commits?per_page=6`);
          if (commitsEl) {
            commitsEl.innerHTML = commits
              .map(
                (c) => `
                <li class="flex items-start justify-between gap-2 pb-2 border-b border-[var(--border)]/50 last:border-0">
                  <a href="${c.html_url}" target="_blank" rel="noopener noreferrer" class="text-[var(--text)] hover:underline line-clamp-1">
                    ${escapeHtml(c.commit.message.split('\n')[0])}
                  </a>
                  <span class="font-mono text-[11px] text-[var(--text-muted)] shrink-0">${c.sha.slice(0, 7)}</span>
                </li>`
              )
              .join('');
          }
        } catch (err) {
          if (commitsEl) commitsEl.innerHTML = `<li class="text-red-400">${err.message}</li>`;
        }

        try {
          const [views, clones, referrers] = await Promise.all([
            ghFetch(`/repos/${OWNER}/${REPO}/traffic/views`),
            ghFetch(`/repos/${OWNER}/${REPO}/traffic/clones`),
            ghFetch(`/repos/${OWNER}/${REPO}/traffic/popular/referrers`),
          ]);

          document.getElementById('kpi-views').textContent = views.count ?? 0;
          document.getElementById('kpi-uniques').textContent = `${views.uniques ?? 0} unique`;
          document.getElementById('kpi-clones').textContent = `${clones.count ?? 0} clones (14d)`;

          if (trafficEl) {
            if (!referrers || referrers.length === 0) {
              trafficEl.innerHTML = '<p>No external referrers recorded in the last 14 days.</p>';
            } else {
              trafficEl.innerHTML = referrers
                .slice(0, 5)
                .map(
                  (r) => `
                  <div class="flex items-center justify-between py-1 border-b border-[var(--border)]/50 last:border-0">
                    <span class="font-mono text-[var(--text)]">${escapeHtml(r.referrer)}</span>
                    <span class="font-mono tabular-nums">${r.count} views (${r.uniques} uniq)</span>
                  </div>`
                )
                .join('');
            }
          }
        } catch {
          document.getElementById('kpi-views').textContent = 'N/A';
          document.getElementById('kpi-uniques').textContent = 'needs Admin:Read';
          if (trafficEl) {
            trafficEl.innerHTML = '<p class="text-[var(--text-muted)]">Add <strong>Administration: Read</strong> permission to your GitHub token to view 14-day repository traffic.</p>';
          }
        }
      }

      function renderAnalytics() {
        const source = loadedPosts.length > 0 ? loadedPosts : [];
        const published = source.length ? source.filter((p) => !p.data.draft).length : (buildStats.published ?? 0);
        const drafts = source.length ? source.filter((p) => !!p.data.draft).length : (buildStats.drafts ?? 0);
        const en = source.length ? source.filter((p) => p.data.lang === 'en' && !p.data.draft).length : (buildStats.en ?? 0);
        const fr = source.length ? source.filter((p) => p.data.lang === 'fr' && !p.data.draft).length : (buildStats.fr ?? 0);
        const words = source.length ? source.reduce((a, p) => a + p.words, 0) : (buildStats.totalWords ?? 0);

        document.getElementById('kpi-published').textContent = published;
        document.getElementById('kpi-drafts').textContent = `${drafts} drafts`;
        document.getElementById('kpi-langs').textContent = `${en} / ${fr}`;
        document.getElementById('kpi-words').textContent = words.toLocaleString();

        const tagCounts = {};
        source.forEach((p) => {
          (p.data.tags || []).forEach((t) => {
            tagCounts[t] = (tagCounts[t] || 0) + 1;
          });
        });

        const tagsChart = document.getElementById('tags-chart');
        const entries = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 6);
        if (tagsChart) {
          if (entries.length === 0) {
            tagsChart.innerHTML = '<p class="text-[var(--text-muted)]">No tags yet. Publish your first article!</p>';
          } else {
            const max = entries[0][1];
            tagsChart.innerHTML = entries
              .map(
                ([tag, count]) => `
                <div class="space-y-1">
                  <div class="flex justify-between font-mono">
                    <span class="text-[var(--text)]">#${escapeHtml(tag)}</span>
                    <span class="text-[var(--text-muted)] tabular-nums">${count}</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-[var(--bg-subtle)] overflow-hidden">
                    <div class="h-full rounded-full bg-[var(--text)]" style="width: ${Math.round((count / max) * 100)}%"></div>
                  </div>
                </div>`
              )
              .join('');
          }
        }
      }

      // Tabs switching
      function switchTab(tabName) {
        document.querySelectorAll('.admin-tab').forEach((btn) => {
          const active = btn.getAttribute('data-tab-btn') === tabName;
          btn.classList.toggle('bg-[var(--text)]', active);
          btn.classList.toggle('text-[var(--bg)]', active);
          btn.classList.toggle('text-[var(--text-muted)]', !active);
        });
        ['analytics', 'posts', 'editor'].forEach((id) => {
          document.getElementById(`tab-${id}`)?.classList.toggle('hidden', id !== tabName);
        });
      }

      document.querySelectorAll('.admin-tab').forEach((btn) => {
        btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab-btn')));
      });

      document.getElementById('new-post-shortcut')?.addEventListener('click', () => {
        resetEditor();
        switchTab('editor');
      });

      document.querySelectorAll('.admin-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentFilter = btn.getAttribute('data-admin-filter') || 'all';
          document.querySelectorAll('.admin-filter-btn').forEach((b) => {
            const active = b === btn;
            b.classList.toggle('bg-[var(--text)]', active);
            b.classList.toggle('text-[var(--bg)]', active);
            b.classList.toggle('border', !active);
            b.classList.toggle('border-[var(--border)]', !active);
            b.classList.toggle('text-[var(--text-muted)]', !active);
          });
          renderPostsList();
        });
      });

      // Editor logic
      const edTitle = document.getElementById('ed-title');
      const edSlug = document.getElementById('ed-slug');
      const edDate = document.getElementById('ed-date');
      const edDesc = document.getElementById('ed-description');
      const edLang = document.getElementById('ed-lang');
      const edCat = document.getElementById('ed-category');
      const edTags = document.getElementById('ed-tags');
      const edTranslationSlug = document.getElementById('ed-translation-slug');
      const edDraft = document.getElementById('ed-draft');
      const edFeatured = document.getElementById('ed-featured');
      const edPopular = document.getElementById('ed-popular');
      const edBody = document.getElementById('ed-body');
      const edPreview = document.getElementById('ed-preview');
      const edStats = document.getElementById('ed-stats');
      const edCommitMsg = document.getElementById('ed-commit-msg');
      const edHeading = document.getElementById('editor-heading');

      function updateEditorStatsAndPreview() {
        const text = edBody?.value || '';
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        const mins = Math.max(1, Math.ceil(words / 220));
        if (edStats) edStats.textContent = `${words} words · ${mins} min read`;
        if (edPreview) edPreview.innerHTML = renderMarkdownPreview(text);
        localStorage.setItem(
          DRAFT_KEY,
          JSON.stringify({
            title: edTitle?.value,
            slug: edSlug?.value,
            date: edDate?.value,
            description: edDesc?.value,
            lang: edLang?.value,
            category: edCat?.value,
            tags: edTags?.value,
            translationSlug: edTranslationSlug?.value,
            body: text,
          })
        );
      }

      function resetEditor() {
        editingSha = null;
        editingOriginalPath = null;
        if (edHeading) edHeading.textContent = 'New Article';
        if (edTitle) edTitle.value = '';
        if (edSlug) edSlug.value = '';
        if (edDate) edDate.value = new Date().toISOString().slice(0, 10);
        if (edDesc) edDesc.value = '';
        if (edLang) edLang.value = 'en';
        if (edCat) edCat.value = 'ai';
        if (edTags) edTags.value = '';
        if (edTranslationSlug) edTranslationSlug.value = '';
        if (edDraft) edDraft.checked = false;
        if (edFeatured) edFeatured.checked = false;
        if (edPopular) edPopular.checked = false;
        if (edBody) edBody.value = '';
        if (edCommitMsg) edCommitMsg.value = '';
        updateEditorStatsAndPreview();
      }

      function loadPostIntoEditor(post) {
        editingSha = post.sha;
        editingOriginalPath = post.path;
        if (edHeading) edHeading.textContent = `Editing: ${post.name}`;
        if (edTitle) edTitle.value = post.data.title || '';
        if (edSlug) edSlug.value = post.name.replace(/\.(md|mdx)$/, '');
        if (edDate) edDate.value = String(post.data.pubDate || '').slice(0, 10);
        if (edDesc) edDesc.value = post.data.description || '';
        if (edLang) edLang.value = post.data.lang || 'en';
        if (edCat) edCat.value = post.data.category || 'ai';
        if (edTags) edTags.value = (post.data.tags || []).join(', ');
        if (edTranslationSlug) edTranslationSlug.value = post.data.translationSlug || '';
        if (edDraft) edDraft.checked = !!post.data.draft;
        if (edFeatured) edFeatured.checked = !!post.data.featured;
        if (edPopular) edPopular.checked = !!post.data.popular;
        if (edBody) edBody.value = post.body || '';
        updateEditorStatsAndPreview();
        switchTab('editor');
      }

      edTitle?.addEventListener('input', () => {
        if (!editingSha && edSlug) edSlug.value = slugify(edTitle.value);
        updateEditorStatsAndPreview();
      });
      edBody?.addEventListener('input', updateEditorStatsAndPreview);
      document.getElementById('editor-reset-btn')?.addEventListener('click', () => {
        localStorage.removeItem(DRAFT_KEY);
        resetEditor();
      });

      // Markdown toolbar actions
      document.querySelectorAll('[data-md-insert]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!edBody) return;
          const ins = btn.getAttribute('data-md-insert') || '';
          const start = edBody.selectionStart;
          edBody.setRangeText(ins, start, edBody.selectionEnd, 'end');
          edBody.focus();
          updateEditorStatsAndPreview();
        });
      });

      document.querySelectorAll('[data-md-wrap]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!edBody) return;
          const w = btn.getAttribute('data-md-wrap') || '';
          const start = edBody.selectionStart;
          const end = edBody.selectionEnd;
          const selected = edBody.value.slice(start, end) || 'text';
          edBody.setRangeText(`${w}${selected}${w}`, start, end, 'select');
          edBody.focus();
          updateEditorStatsAndPreview();
        });
      });

      // View mode toggle
      document.querySelectorAll('.view-mode-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-view-mode');
          const panes = document.getElementById('editor-panes');
          document.querySelectorAll('.view-mode-btn').forEach((b) => {
            const active = b === btn;
            b.classList.toggle('bg-[var(--text)]', active);
            b.classList.toggle('text-[var(--bg)]', active);
            b.classList.toggle('text-[var(--text-muted)]', !active);
          });
          if (mode === 'write') {
            edBody?.classList.remove('hidden');
            edPreview?.classList.add('hidden');
            panes?.classList.remove('md:grid-cols-2');
          } else if (mode === 'preview') {
            edBody?.classList.add('hidden');
            edPreview?.classList.remove('hidden');
            panes?.classList.remove('md:grid-cols-2');
          } else {
            edBody?.classList.remove('hidden');
            edPreview?.classList.remove('hidden');
            panes?.classList.add('md:grid-cols-2');
          }
        });
      });

      async function savePostToGitHub(forceDraft) {
        const title = edTitle?.value.trim();
        const slug = slugify(edSlug?.value.trim() || title || '');
        const desc = edDesc?.value.trim();
        const date = edDate?.value || new Date().toISOString().slice(0, 10);
        const body = edBody?.value || '';

        if (!title || !slug || !desc || !body.trim()) {
          showToast('Please fill in Title, Slug, Description, and Article Body.', 'error');
          return;
        }

        const isDraft = forceDraft ? true : !!edDraft?.checked;
        const tags = (edTags?.value || '')
          .split(',')
          .map((t) => `"${t.trim()}"`)
          .filter((t) => t !== '""');

        const translationSlug = edTranslationSlug?.value.trim();
        const markdown = [
          '---',
          `title: "${title.replace(/"/g, '\\"')}"`,
          `description: "${desc.replace(/"/g, '\\"')}"`,
          `pubDate: ${date}`,
          `lang: "${edLang?.value || 'en'}"`,
          `category: "${edCat?.value || 'ai'}"`,
          `tags: [${tags.join(', ')}]`,
          `draft: ${isDraft}`,
          `featured: ${!!edFeatured?.checked}`,
          `popular: ${!!edPopular?.checked}`,
          ...(translationSlug ? [`translationSlug: "${translationSlug.replace(/"/g, '\\"')}"`] : []),
          '---',
          '',
          body.trim(),
          '',
        ].join('\n');

        const targetPath = `${POSTS_PATH}/${slug}.md`;
        const commitMsg =
          edCommitMsg?.value.trim() ||
          `${editingSha ? 'update' : 'feat'}(post): ${isDraft ? 'save draft' : 'publish'} ${slug}`;

        try {
          showToast('Pushing article to GitHub...', 'info');
          const payload = {
            message: commitMsg,
            content: encodeBase64Utf8(markdown),
            ...(editingSha && editingOriginalPath === targetPath ? { sha: editingSha } : {}),
          };

          const result = await ghFetch(`/repos/${OWNER}/${REPO}/contents/${targetPath}`, {
            method: 'PUT',
            body: JSON.stringify(payload),
          });

          editingSha = result.content?.sha || null;
          editingOriginalPath = targetPath;
          localStorage.removeItem(DRAFT_KEY);

          showToast(
            `Saved <code>${slug}.md</code> to <code>main</code>! <a href="${result.commit?.html_url}" target="_blank" class="underline font-medium">View commit</a>`,
            'success'
          );
          await syncAllData();
        } catch (err) {
          showToast(`Publish failed: ${err.message}`, 'error');
        }
      }

      document.getElementById('save-draft-btn')?.addEventListener('click', () => savePostToGitHub(true));
      document.getElementById('publish-btn')?.addEventListener('click', () => savePostToGitHub(false));
      document.getElementById('refresh-data-btn')?.addEventListener('click', syncAllData);

      // GoatCounter config
      const gcInput = document.getElementById('gc-code-input');
      const gcStatus = document.getElementById('gc-status');
      const savedGc = localStorage.getItem(GC_KEY) || buildStats.goatcounterCode || '';
      if (savedGc && gcInput && gcStatus) {
        gcInput.value = savedGc;
        gcStatus.innerHTML = `Configured: <a href="https://${encodeURIComponent(savedGc)}.goatcounter.com" target="_blank" class="underline text-[var(--text)]">${escapeHtml(savedGc)}.goatcounter.com</a>`;
      }
      document.getElementById('gc-save-btn')?.addEventListener('click', () => {
        const code = gcInput?.value.trim() || '';
        if (!code) {
          localStorage.removeItem(GC_KEY);
          if (gcStatus) gcStatus.textContent = 'Cleared.';
          return;
        }
        localStorage.setItem(GC_KEY, code);
        if (gcStatus) {
          gcStatus.innerHTML = `Saved! View live dashboard at <a href="https://${encodeURIComponent(code)}.goatcounter.com" target="_blank" class="underline text-[var(--text)]">${escapeHtml(code)}.goatcounter.com</a>`;
        }
      });

      // Request access form
      document.getElementById('request-access-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('req-name')?.value.trim();
        const email = document.getElementById('req-email')?.value.trim();
        const reason = document.getElementById('req-reason')?.value.trim();
        const title = encodeURIComponent(`[Admin Access Request] ${name}`);
        const body = encodeURIComponent(`**Requester:** ${name}\n**Email:** ${email}\n\n**Reason / Topic:**\n${reason}`);
        window.open(`https://github.com/${OWNER}/${REPO}/issues/new?title=${title}&body=${body}`, '_blank', 'noopener');
      });

      // Login / Logout
      document.getElementById('login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pat = document.getElementById('pat-input')?.value.trim() || '';
        const remember = document.getElementById('remember-token')?.checked;
        if (remember) {
          localStorage.setItem(TOKEN_KEY, pat);
        } else {
          sessionStorage.setItem(TOKEN_KEY, pat);
        }
        await verifyAndUnlock(pat);
      });

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        token = '';
        sessionStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem(TOKEN_KEY);
        location.reload();
      });

      // Init
      if (edDate) edDate.value = new Date().toISOString().slice(0, 10);
      const savedToken = sessionStorage.getItem(TOKEN_KEY) || localStorage.getItem(TOKEN_KEY);
      if (savedToken) {
        verifyAndUnlock(savedToken);
      }
    })();
  </script>
</BaseLayout>
