---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const lastPosts = allPosts.slice(0, 5);
const popularPosts = allPosts.filter((p) => p.data.popular || p.data.featured).slice(0, 5);
---

<BaseLayout
  title="KAK — Intelligence Artificielle & Outils de Développement"
  description="Notes techniques, architectures IA et outils de développement par Konaté Abdoul Karim."
>
  <!-- Hero matching Codelynx clean editorial aesthetic -->
  <section class="mb-14">
    <h1
      class="font-display text-3xl sm:text-[40px] font-medium tracking-tight text-[var(--text)] leading-[1.15]"
      data-i18n-fr="KAK — Ingénierie IA & Outils de développement"
      data-i18n-en="KAK — AI Engineering & Developer Tools"
    >
      KAK &mdash; AI Engineering &amp; Developer Tools
    </h1>

    <p
      class="mt-4 text-sm sm:text-base text-[var(--text-muted)] leading-relaxed max-w-xl"
      data-i18n-fr="Notes techniques sur l'intelligence artificielle, les agents autonomes, l'architecture logicielle et les outils modernes pour construire plus vite."
      data-i18n-en="Technical notes on artificial intelligence, autonomous agents, software architecture, and modern tools for building faster."
    >
      Technical notes on artificial intelligence, autonomous agents, software architecture, and modern tools for building faster.
    </p>
  </section>

  <!-- Last articles -->
  <section class="mb-14">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="font-pixel text-2xl sm:text-[26px] tracking-tight text-[var(--text)]">
        Last articles
      </h2>
      <a
        href="/posts/"
        class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
        data-i18n-fr="Voir tout →"
        data-i18n-en="View all →"
      >
        Voir tout &rarr;
      </a>
    </div>

    {
      lastPosts.length > 0 ? (
        <div class="divide-y divide-[var(--border)]/60">
          {lastPosts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-[var(--border)] bg-[var(--bg-elevated)]/40 px-5 py-8 text-center">
          <p
            class="text-sm text-[var(--text-muted)]"
            data-i18n-fr="Aucun article publié pour le moment. Les premiers articles arrivent bientôt."
            data-i18n-en="No articles published yet. First notes are coming soon."
          >
            Aucun article publié pour le moment. Les premiers articles arrivent bientôt.
          </p>
        </div>
      )
    }
  </section>

  <!-- Popular articles -->
  <section>
    <h2 class="font-pixel text-2xl sm:text-[26px] tracking-tight text-[var(--text)] mb-5">
      Popular articles
    </h2>

    {
      popularPosts.length > 0 ? (
        <div class="divide-y divide-[var(--border)]/60">
          {popularPosts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-[var(--border)] bg-[var(--bg-elevated)]/40 px-5 py-8 text-center">
          <p
            class="text-sm text-[var(--text-muted)]"
            data-i18n-fr="Les articles les plus lus apparaîtront ici."
            data-i18n-en="Most read articles will appear here."
          >
            Les articles les plus lus apparaîtront ici.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
