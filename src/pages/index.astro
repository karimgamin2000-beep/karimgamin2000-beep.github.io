---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = allPosts.find((p) => p.data.featured);
const remainingPosts = featuredPost
  ? allPosts.filter((p) => p.id !== featuredPost.id)
  : allPosts;

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="KARIM.DEV — AI Engineering & Software Notes"
  description="Long-form technical notes on AI engineering, autonomous dev workflows, data pipelines, and building software in public."
>
  <!-- Editorial Hero (Karpathy clarity × Codelynx typography) -->
  <section class="mb-12">
    <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-tight text-[var(--text)] leading-[1.12]">
      Technical <span class="font-serif-editorial italic font-normal text-[var(--accent)]">Notes</span> &amp; Field Logs
    </h1>

    <p class="mt-4 text-base sm:text-lg text-[var(--text-muted)] leading-relaxed max-w-xl">
      Computer Science student at IIT &amp; aspiring AI / Robotics Engineer.
      Writing sharp, practical essays on <span class="text-[var(--text)] font-medium">AI systems</span>,
      <span class="text-[var(--text)] font-medium">software factories</span>, and
      <span class="text-[var(--text)] font-medium">data pipelines</span>.
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-4 text-xs font-mono text-[var(--text-muted)]">
      <a
        href="https://github.com/karimgamin2000-beep"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 hover:text-[var(--text)] transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>@karimgamin2000-beep</span>
      </a>
      <span aria-hidden="true">&middot;</span>
      <a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:text-[var(--text)] transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
        </svg>
        <span>RSS Feed</span>
      </a>
      <span aria-hidden="true">&middot;</span>
      <span class="tabular-nums">{allPosts.length} articles (EN / FR)</span>
    </div>
  </section>

  <!-- Search + Filter Controls -->
  <section class="mb-8 space-y-3">
    <div class="relative">
      <svg
        class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--text-muted)]"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
      </svg>
      <input
        id="post-search"
        type="search"
        placeholder="Search articles, topics, or tags..."
        aria-label="Search articles"
        class="w-full rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] pl-9 pr-12 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-muted)] focus:border-[var(--accent)] focus:outline-none transition-colors"
      />
      <kbd class="pointer-events-none hidden sm:inline-flex items-center justify-center absolute right-2.5 top-1/2 -translate-y-1/2 px-1.5 py-0.5 text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border)] rounded bg-[var(--bg-subtle)]">
        /
      </kbd>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
      <div class="flex items-center gap-1.5" role="group" aria-label="Filter by language">
        <button
          data-lang-btn="all"
          class="lang-btn px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-[var(--text)] text-[var(--bg)] transition-colors cursor-pointer"
        >
          All
        </button>
        <button
          data-lang-btn="en"
          class="lang-btn px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer"
        >
          EN
        </button>
        <button
          data-lang-btn="fr"
          class="lang-btn px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer"
        >
          FR
        </button>
      </div>

      {
        allTags.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <button
              data-tag-btn="all"
              class="tag-btn px-2 py-0.5 rounded text-[11px] font-mono bg-[var(--accent-soft)] text-[var(--accent)] border border-[var(--accent)]/30 cursor-pointer"
            >
              #all
            </button>
            {allTags.map((tag) => (
              <button
                data-tag-btn={tag}
                class="tag-btn px-2 py-0.5 rounded text-[11px] font-mono border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer"
              >
                #{tag}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Featured Post -->
  {
    featuredPost && (
      <div class="mb-6">
        <PostCard post={featuredPost} variant="featured" />
      </div>
    )
  }

  <!-- Editorial Post Rows -->
  <section class="divide-y divide-[var(--border)]" id="posts-list">
    {remainingPosts.map((post) => <PostCard post={post} variant="row" />)}
  </section>

  <p id="empty-state" class="hidden py-12 text-center font-mono text-sm text-[var(--text-muted)]">
    No articles match your current search or filter.
  </p>
</BaseLayout>

<script is:inline>
  (function () {
    let activeLang = 'all';
    let activeTag = 'all';
    let searchQuery = '';

    const searchInput = document.getElementById('post-search');
    const langBtns = document.querySelectorAll('.lang-btn');
    const tagBtns = document.querySelectorAll('.tag-btn');
    const cards = document.querySelectorAll('[data-post-card]');
    const emptyState = document.getElementById('empty-state');

    function applyFilters() {
      let visible = 0;
      cards.forEach((card) => {
        const cardLang = card.getAttribute('data-lang');
        const cardTags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
        const searchBlob = card.getAttribute('data-search') || '';
        const langMatch = activeLang === 'all' || cardLang === activeLang;
        const tagMatch = activeTag === 'all' || cardTags.includes(activeTag);
        const queryMatch = !searchQuery || searchBlob.includes(searchQuery);
        const show = langMatch && tagMatch && queryMatch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      applyFilters();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeLang = btn.getAttribute('data-lang-btn') || 'all';
        langBtns.forEach((b) => {
          const isCurrent = b === btn;
          b.classList.toggle('bg-[var(--text)]', isCurrent);
          b.classList.toggle('text-[var(--bg)]', isCurrent);
          b.classList.toggle('border', !isCurrent);
          b.classList.toggle('border-[var(--border)]', !isCurrent);
          b.classList.toggle('text-[var(--text-muted)]', !isCurrent);
        });
        applyFilters();
      });
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTag = btn.getAttribute('data-tag-btn') || 'all';
        tagBtns.forEach((b) => {
          const isCurrent = b === btn;
          b.classList.toggle('bg-[var(--accent-soft)]', isCurrent);
          b.classList.toggle('text-[var(--accent)]', isCurrent);
          b.classList.toggle('border-[var(--accent)]/30', isCurrent);
          b.classList.toggle('border-[var(--border)]', !isCurrent);
          b.classList.toggle('text-[var(--text-muted)]', !isCurrent);
        });
        applyFilters();
      });
    });
  })();
</script>
